{
  "description": "relaybay's behaviour without a policy file.",
  "levels": {
    "local": {"default": "full"},
    "test": {"default": "full"},
    "live": {"default": "read"}
  },
  "guard": {"mode": "warn", "disable": [], "patterns": []},
  "approvals": {
    "commit": false,
    "push": true,
    "merge": true,
    "test": true,
    "live": true,
    "desktop": false,
    "valid_minutes": 120,
    "disable": [],
    "ignore": []
  },
  "secrets": {
    "disable": [],
    "allow": [],
    "test_secrets": {"local": false, "test": false},
    "expose_test_secrets_to_agents": false
  }
}
